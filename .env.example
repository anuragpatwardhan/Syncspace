# Copy this file to .env and fill in values

# --- Backend ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://syncspace:syncspace@localhost:5432/syncspace

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace_me_with_64_bytes_of_random_hex
JWT_EXPIRES_IN=7d

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Frontend (Vite reads VITE_*) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
